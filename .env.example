# Server Network & Port Configuration
PORT=3000
NODE_ENV=development
DEVICE_NAME=My-Storage-Node
HOST=0.0.0.0

# Database Configuration (MySQL + Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/local_storage"

# Storage Configuration (relative to project root or absolute)
STORAGE_DIR="./storage"

# LAN Discovery Configuration (UDP Broadcast)
DISCOVERY_PORT=41234
DISCOVERY_INTERVAL_MS=3000
DISCOVERY_PEER_TIMEOUT_MS=10000

# Client Configuration
VITE_API_PORT=3000
